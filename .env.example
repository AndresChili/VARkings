# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# API-Football (https://www.api-football.com — sign up for free key)
RAPIDAPI_KEY=your-api-football-key

# App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Web Push Notifications (VAPID keys - generate with: npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_EMAIL=mailto:your@email.com

# Cron secret (protects cron endpoints) — generate with: openssl rand -base64 32
CRON_SECRET=your-random-secret-string

# Superadmin email (grants access to /admin and suggestions management)
SUPERADMIN_EMAIL=your@email.com

# Upstash Redis (distributed rate limiting — https://upstash.com, free tier available)
# Without these, rate limiting falls back to in-memory (per serverless instance)
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token
